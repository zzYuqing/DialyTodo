{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DailyTodo",
  "version": "0.1.0",
  "identifier": "com.yoyo.dailytodo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DailyTodo",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "url": "index.html"
      },
      {
        "label": "pet",
        "title": "DailyTodo 桌宠",
        "width": 168,
        "height": 168,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "src/pet/pet.html"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "daily-todo-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
